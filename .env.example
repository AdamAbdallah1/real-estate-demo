# Copy to .env.local and fill in the values from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
#
# These are CLIENT-SIDE configuration values, not secrets. They are safe to
# ship in the browser bundle. They do NOT grant access to data on their own:
# access is enforced by Firebase Authentication and Firestore Security Rules.
# Never place Admin SDK / service-account credentials in this frontend repo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
